{
  "name": "at",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "prepare": "bun --bun husky",
    "format": "bun --bun oxfmt .",
    "format:check": "bun --bun oxfmt --check .",
    "lint": "bun --bun oxlint --deny-warnings .",
    "typecheck": "bun --bun tsc --noEmit && bun --bun tsc --project tsconfig.test.json --noEmit",
    "architecture": "bun --bun depcruise --config .dependency-cruiser.cjs .",
    "test": "bun --bun vitest run",
    "mutation": "bun --preload @stryker-mutator/vitest-runner ./node_modules/@stryker-mutator/core/bin/stryker.js run",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run architecture && bun run test",
    "precommit": "bun --bun lint-staged"
  },
  "dependencies": {
    "neverthrow": "8.2.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "dependency-cruiser": "18.7.2",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,md}": [
      "bun --bun oxfmt",
      "bun --bun oxlint --deny-warnings"
    ]
  },
  "packageManager": "bun@1.3.13"
}
